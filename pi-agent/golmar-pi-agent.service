[Unit]
Description=Golmar Scrypted Pi Agent
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dev/golmar-scrypted-intercom/pi-agent
ExecStart=/home/pi/venvs/automationhat/bin/python /home/pi/dev/golmar-scrypted-intercom/pi-agent/agent.py
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
